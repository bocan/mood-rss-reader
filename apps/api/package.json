{
  "name": "@rss/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:migrate": "node dist/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "@mozilla/readability": "0.6.0",
    "@node-rs/argon2": "2.2.2",
    "@rss/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "fastify": "5.12.8",
    "linkedom": "0.18.15",
    "node-html-parser": "9.0.7",
    "postgres": "4.1.1",
    "rss-parser": "3.13.0",
    "sanitize-html": "2.18.2",
    "undici": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.11",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "microformats-parser": "2.0.6",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
