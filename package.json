{
  "name": "rss-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @rss/api db:generate",
    "db:migrate": "pnpm --filter @rss/api db:migrate",
    "db:studio": "pnpm --filter @rss/api db:studio",
    "docker:build": "docker build -f docker/Dockerfile -t rss-reader .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
